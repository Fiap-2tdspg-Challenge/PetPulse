th="60" height="18" as="geometry"/></mxCell><mxCell id="n8_1200_585" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1187" y="572" width="26" height="26" as="geometry"/></mxCell><mxCell id="l8a" value="EF Core (Oracle)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;labelBackgroundColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1225" y="562" width="110" height="18" as="geometry"/></mxCell><mxCell id="n8_1200_615" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1187" y="602" width="26" height="26" as="geometry"/></mxCell><mxCell id="l8b" value="MongoDB.Driver (leituras IoT)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1340" y="724" width="200" height="18" as="geometry"/></mxCell><mxCell id="n9_1205_318" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1192" y="305" width="26" height="26" as="geometry"/></mxCell><mxCell id="l9" value="HTTPS (REST + JWT)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1213" y="262" width="120" height="18" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;b&gt;Fluxo da esteira CI/CD&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; O desenvolvedor faz commit/push na branch main do GitHub.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; O push dispara automaticamente a pipeline YAML no Azure DevOps (Stage CI).&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Job 1 (Azure CLI + infra-webapp.sh): cria as tabelas no Oracle FIAP se não existirem e cria/reaproveita RG, Plano e Web App.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Job 2: restore, build e testes automatizados (xUnit) com cobertura publicada no Azure DevOps.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; O CI gera e publica o artefato “app” (.zip da PetPulse.API) no Azure DevOps." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="1040" width="810" height="125" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt; O novo artefato dispara o Stage CD (deployment no environment producao).&lt;br&gt;&lt;b&gt;7&lt;/b&gt; O CD publica o .zip no Web App e grava as App Settings a partir das variáveis secretas da pipeline.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; A API em produção persiste no Oracle FIAP (EF Core) e grava o histórico de leituras IoT no MongoDB Atlas.&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Tutor/clínica (app), coleira ESP32 e Swagger/Postman consomem a API via HTTPS com token JWT." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="975" y="1040" width="795" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>